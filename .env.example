# Copy to .env and fill in the required keys.

# --- Required (or use SEARCH_PROVIDER=duckduckgo to skip Tavily) ---
OPENAI_API_KEY=nvapi-...
TAVILY_API_KEY=tvly-...

# --- Search provider: "tavily" | "exa" | "duckduckgo" (duckduckgo is keyless) ---
SEARCH_PROVIDER=duckduckgo
# EXA_API_KEY=...

# --- LLM / embeddings: any OpenAI-compatible endpoint (NVIDIA NIM by default) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_BASE_URL=https://integrate.api.nvidia.com/v1
PLANNER_MODEL=meta/llama-3.3-70b-instruct
WRITER_MODEL=meta/llama-3.3-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# --- Postgres (port must match docker-compose.yml: 5434) ---
DATABASE_URL=postgresql+psycopg://research:research@localhost:5434/research

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks

# --- Bounds: autonomy lives inside these caps ---
MAX_QUERIES=5
MAX_SOURCES=10
MAX_ROUNDS=2
MAX_TOTAL_SECONDS=240
TOP_K=12
PLANNER_TIMEOUT=45
WRITER_TIMEOUT=120
CHUNK_SIZE=800
CHUNK_OVERLAP=120
